# Environment Configuration for WealthHub Backend

# Database: PostgreSQL URL for production/staging (or SQLite fallback for local testing)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wealthhub
# DATABASE_URL=sqlite:///./wealthhub.db

# JWT & Authentication Security
JWT_SECRET=wealthhub-super-secret-jwt-signing-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Application Environment
ENVIRONMENT=development
DEBUG=True

# Groww Broker API (Optional for live sync)
GROWW_API_BASE_URL=https://api.groww.in
GROWW_API_VERSION=1.0
GROWW_TIMEOUT_SECONDS=15.0

# Setu Account Aggregator (AA) Sandbox Configuration
# Setu provides sandbox environment for FIU consent and data sessions:
# - Register at Setu Developer Portal (https://setu.co)
# - Create a sandbox FIU product instance
# - Configure Client ID, Client Secret, and Product Instance ID below
# NOTE: Do NOT commit secrets or put fake credentials in .env.
# When SETU_LIVE_TEST=false or credentials are omitted, WealthHub runs in safe SANDBOX_MOCK mode.
# When SETU_LIVE_TEST=true, tests communicate directly with the Setu sandbox HTTP endpoints.
SETU_ENVIRONMENT=sandbox
SETU_BASE_URL=https://fiu-sandbox.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
SETU_TIMEOUT_SECONDS=15.0
SETU_LIVE_TEST=false

